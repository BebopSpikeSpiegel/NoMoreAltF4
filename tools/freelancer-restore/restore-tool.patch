+// =============================================================================
+// Freelancer campaign restore (one shot)
+// =============================================================================
+// The Freelancer campaign (carried items, merces, campaign step, safehouse) is
+// one key/value store on IOI's server, written only by the game's own CpdSet
+// events and served back in every Freelancer GetForPlay2 response as
+// ContractProgressionData. A saved copy of that store can therefore be put back
+// by one CpdSet that carries all of its values. The restore rides on a CpdSet
+// the game itself sends from the safehouse (same event, same Id, same session):
+// only its Value object is replaced. The request is really sent; once the
+// server answers 200 the game is closed, because its in-memory campaign is the
+// pre-restore one and would overwrite the restored values with its next upload.
+enum : int { k_RestoreIdle = 0, k_RestoreArmed, k_RestoreSent, k_RestoreAccepted, k_RestoreFailed };
+static std::atomic<int> s_RestoreState{ k_RestoreIdle };
+static std::atomic<HINTERNET> s_RestoreRequest{ nullptr };
+static std::atomic<uint32_t> s_RestoreHttpStatus{ 0 };
+static std::atomic<uint64_t> s_RestoreSentAtMs{ 0 };
+
+// Written on the render thread under the exclusive lock (only while not armed
+// or sent); RestoreFilter reads them under the shared lock.
+static SRWLOCK s_RestoreLock = SRWLOCK_INIT;
+static std::string s_RestoreContractId;  // CpdId: the Freelancer safehouse contract id
+static std::string s_RestoreValues;      // one JSON object
+static std::string s_RestoreSummary;     // human-readable line from the file
+static std::string s_RestoreLoadError;   // why the file is not usable ("" = loaded)
+
+static constexpr const char* k_RestoreFileName = "freelancer-restore.json";
+static constexpr size_t k_RestoreMaxBytes = 4u << 20;
+static constexpr uint64_t k_RestoreAnswerTimeoutMs = 10000;  // then the game is closed anyway
+
+// The only carrier the restore uses: a 1-key upload with a plain number, such
+// as {"GearWall_ThematicIndex":2.000000} or {"MyValue01":1.000000}, which the
+// game sends when the player pages through a safehouse display. Never a
+// departure or quit upload, which carries many keys.
+static bool IsSingleNumberCarrier(std::string_view p_Value)
+{
+    // {"<key>":<number>}
+    if (p_Value.size() < 6 || p_Value.front() != '{' || p_Value.back() != '}' || p_Value[1] != '"')
+        return false;
+    const size_t s_KeyEnd = p_Value.find('"', 2);
+    if (s_KeyEnd == std::string_view::npos || s_KeyEnd + 2 >= p_Value.size() - 1 || p_Value[s_KeyEnd + 1] != ':')
+        return false;
+    for (size_t i = 2; i < s_KeyEnd; ++i)
+    {
+        const char c = p_Value[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'))
+            return false;
+    }
+    bool s_Digit = false;
+    for (size_t i = s_KeyEnd + 2; i < p_Value.size() - 1; ++i)
+    {
+        const char c = p_Value[i];
+        if (c >= '0' && c <= '9')
+            s_Digit = true;
+        else if (c != '.' && c != '-')
+            return false;
+    }
+    return s_Digit;
+}
+
 // Session id of the Freelancer safehouse visit in progress (ContractStart with
 // LocationId LOCATION_SNUG). Static, like the ebr kind table, so a disable /
 // re-enable of the plugin keeps it. Game thread (OnEventSent) only.
 static std::string s_SafehouseCsid;
+
+static bool IsGuidText(std::string_view p_Text)
+{
+    if (p_Text.size() != 36)
+        return false;
+    for (size_t i = 0; i < p_Text.size(); ++i)
+    {
+        const char c = p_Text[i];
+        const bool s_Dash = (i == 8 || i == 13 || i == 18 || i == 23);
+        if (s_Dash ? c != '-' : !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+            return false;
+    }
+    return true;
+}
 
