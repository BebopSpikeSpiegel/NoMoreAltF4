+// Replaces the Value of the safehouse's next CpdSet with the saved campaign.
+// Static state only. Returns true when the body (and its length) was replaced.
+bool NoMoreAltF4::RestoreFilter(HINTERNET hRequest, LPVOID& lpOptional, DWORD& dwOptionalLength, DWORD& dwTotalLength)
+{
+    if (s_RestoreState.load(std::memory_order_acquire) != k_RestoreArmed)
+        return false;
+    // Only with a live plugin: its WinHTTP callback detour is what closes the
+    // game after the answer.
+    if (s_HookPassthrough.load() || !s_Instance.load())
+        return false;
+    if (!hRequest || !lpOptional || dwOptionalLength == 0 || dwOptionalLength != dwTotalLength
+        || dwOptionalLength > k_RestoreMaxBytes)
+        return false;
+
+    // The game's buffer is read once, into a private copy.
+    std::string s_Body(dwOptionalLength, '\0');
+    if (!GuardedCopy(s_Body.data(), lpOptional, dwOptionalLength))
+        return false;
+    if (!ebr::LooksLikeEventsBody(s_Body.data(), s_Body.size()))
+        return false;
+
+    std::string s_New;
+    std::string s_Cid;
+    size_t s_Begin = 0;
+    size_t s_End = 0;
+    uint32_t s_Events = 0;
+    uint32_t s_Matches = 0;
+    size_t s_ValuesLen = 0;
+
+    AcquireSRWLockShared(&s_RestoreLock);
+    s_Cid = s_RestoreContractId;
+    if (!s_RestoreValues.empty()
+        && ebr::FindCpdSetValue(s_Body.data(), s_Body.size(), s_Cid.data(), s_Cid.size(),
+                                &s_Begin, &s_End, &s_Events, &s_Matches)
+        // Exactly one safehouse CpdSet in the body, and it is a 1-key numeric
+        // upload (paging a safehouse display): anything else keeps waiting, so a
+        // forgotten arm cannot ride on a departure or quit upload.
+        && s_Matches == 1
+        && IsSingleNumberCarrier(std::string_view(s_Body).substr(s_Begin, s_End - s_Begin)))
+    {
+        s_ValuesLen = s_RestoreValues.size();
+        s_New.reserve(s_Body.size() - (s_End - s_Begin) + s_ValuesLen);
+        s_New.append(s_Body, 0, s_Begin);
+        s_New.append(s_RestoreValues);
+        s_New.append(s_Body, s_End, std::string::npos);
+    }
+    ReleaseSRWLockShared(&s_RestoreLock);
+
+    if (s_New.empty())
+        return false;  // not a safehouse CpdSet: keep waiting
+
+    // The result must parse as the same events body with the saved values in place.
+    size_t s_CheckBegin = 0;
+    size_t s_CheckEnd = 0;
+    uint32_t s_CheckEvents = 0;
+    if (s_New.size() > k_RestoreMaxBytes
+        || !ebr::FindCpdSetValue(s_New.data(), s_New.size(), s_Cid.data(), s_Cid.size(),
+                                 &s_CheckBegin, &s_CheckEnd, &s_CheckEvents)
+        || s_CheckEvents != s_Events || s_CheckBegin != s_Begin || s_CheckEnd - s_CheckBegin != s_ValuesLen)
+    {
+        int s_Armed = k_RestoreArmed;
+        if (s_RestoreState.compare_exchange_strong(s_Armed, k_RestoreFailed))
+            Logger::Error("[NoMoreAltF4] RESTORE FAILED: the rebuilt body did not check out; nothing was sent.");
+        return false;
+    }
+
+    // WinHTTP reads the body asynchronously (and again on a redirect), so the
+    // buffer is never freed. One restore is about 25 KB.
+    char* s_Buf = static_cast<char*>(HeapAlloc(GetProcessHeap(), 0, s_New.size()));
+    if (!s_Buf)
+    {
+        int s_Armed = k_RestoreArmed;
+        if (s_RestoreState.compare_exchange_strong(s_Armed, k_RestoreFailed))
+            Logger::Error("[NoMoreAltF4] RESTORE FAILED: out of memory; nothing was sent.");
+        return false;
+    }
+    memcpy(s_Buf, s_New.data(), s_New.size());
+
+    // Only the winner of Armed -> Sent records its handle. No callback for this
+    // request can run before the original WinHttpSendRequest is called.
+    int s_Expected = k_RestoreArmed;
+    if (!s_RestoreState.compare_exchange_strong(s_Expected, k_RestoreSent))
+    {
+        // Disarmed from the menu, or another request won, meanwhile.
+        HeapFree(GetProcessHeap(), 0, s_Buf);
+        return false;
+    }
+    s_RestoreRequest.store(hRequest);
+    s_RestoreSentAtMs.store(GetTickCount64());
+
+    Logger::Warn("[NoMoreAltF4] RESTORE SENT: the safehouse campaign upload now carries the saved campaign "
+                 "(body {} -> {} bytes, {} event(s)). Waiting for the server's answer.",
+                 dwOptionalLength, s_New.size(), s_Events);
+
+    lpOptional = s_Buf;
+    dwOptionalLength = static_cast<DWORD>(s_New.size());
+    dwTotalLength = dwOptionalLength;
+    return true;
+}
+
+void NoMoreAltF4::LoadRestoreFile()
+{
+    const auto s_Folder = m_LogMirror.Folder();
+    std::string s_Error;
+    std::string s_ContractId;
+    std::string s_Summary;
+    std::string s_Values;
+
+    if (s_Folder.empty())
+    {
+        s_Error = "the session log folder is unknown";
+    }
+    else
+    {
+        std::ifstream s_In(s_Folder / k_RestoreFileName, std::ios::binary);
+        if (!s_In)
+        {
+            s_Error = "no file";
+        }
+        else
+        {
+            std::string s_All((std::istreambuf_iterator<char>(s_In)), std::istreambuf_iterator<char>());
+            auto s_Line = [&s_All](size_t& p_Pos) {
+                const size_t s_Nl = s_All.find('\n', p_Pos);
+                std::string s_Out = s_All.substr(p_Pos, s_Nl == std::string::npos ? std::string::npos : s_Nl - p_Pos);
+                p_Pos = (s_Nl == std::string::npos) ? s_All.size() : s_Nl + 1;
+                while (!s_Out.empty() && (s_Out.back() == '\r' || s_Out.back() == ' '))
+                    s_Out.pop_back();
+                return s_Out;
+            };
+
+            size_t s_Pos = 0;
+            s_ContractId = s_Line(s_Pos);
+            s_Summary = s_Line(s_Pos);
+            s_Values = s_Line(s_Pos);
+
+            // A test body with the values in place must parse like a real one.
+            const std::string s_Probe = "{\"userId\":\"probe\",\"values\":[{\"Name\":\"CpdSet\",\"ContractId\":\""
+                + s_ContractId + "\",\"Value\":" + s_Values + "}]}";
+            size_t s_B = 0;
+            size_t s_E = 0;
+            uint32_t s_N = 0;
+
+            if (s_All.size() > k_RestoreMaxBytes)
+                s_Error = "the file is too large";
+            else if (!IsGuidText(s_ContractId))
+                s_Error = "line 1 is not a contract id";
+            else if (s_Summary.size() > 300)
+                s_Error = "line 2 (summary) is too long";
+            else if (s_Values.size() < 2 || s_Values.front() != '{' || s_Values.back() != '}')
+                s_Error = "line 3 is not a JSON object";
+            else if (!ebr::FindCpdSetValue(s_Probe.data(), s_Probe.size(), s_ContractId.data(), s_ContractId.size(),
+                                           &s_B, &s_E, &s_N)
+                     || s_N != 1 || s_E - s_B != s_Values.size())
+                s_Error = "line 3 does not parse as JSON";
+        }
+    }
+
+    AcquireSRWLockExclusive(&s_RestoreLock);
+    if (s_Error.empty())
+    {
+        s_RestoreContractId = s_ContractId;
+        s_RestoreSummary = s_Summary;
+        s_RestoreValues = s_Values;
+    }
+    else
+    {
+        s_RestoreContractId.clear();
+        s_RestoreSummary.clear();
+        s_RestoreValues.clear();
+    }
+    s_RestoreLoadError = s_Error;
+    ReleaseSRWLockExclusive(&s_RestoreLock);
+
+    if (s_Error.empty())
+        Logger::Info("[NoMoreAltF4] Freelancer restore file loaded: {} ({} bytes).", s_Summary, s_Values.size());
+    else if (s_Error != "no file")
+        Logger::Warn("[NoMoreAltF4] Freelancer restore file not usable: {}.", s_Error);
+}
+
+void NoMoreAltF4::DrawRestoreMenu()
+{
+    ImGui::TextUnformatted("Freelancer: restore a saved campaign");
+    if (ImGui::IsItemHovered())
+        ImGui::SetTooltip("Puts back a saved copy of your Freelancer campaign (carried items, merces,\n"
+                          "campaign progress) from %s in the session log folder.\n"
+                          "When armed, the next small campaign upload from the safehouse (paging a\n"
+                          "display such as the gear wall) carries the saved\n"
+                          "campaign instead of its own, and the game closes once the server accepts it.\n"
+                          "Launch again and enter the safehouse to see the result.\n"
+                          "This writes to your online profile and cannot be undone by the mod.",
+                          k_RestoreFileName);
+
+    const int s_State = s_RestoreState.load();
+    const bool s_Busy = (s_State == k_RestoreArmed || s_State == k_RestoreSent);
+
+    if (s_RestoreLoadError.empty())
+        ImGui::Text("Saved campaign: %s", s_RestoreSummary.c_str());
+    else
+        ImGui::TextDisabled("No saved campaign (%s).", s_RestoreLoadError.c_str());
+
+    if (!s_Busy && ImGui::Button("Reload file##restore"))
+        LoadRestoreFile();
+
+    switch (s_State)
+    {
+    case k_RestoreIdle:
+    case k_RestoreFailed:
+        if (s_State == k_RestoreFailed)
+            ImGui::TextColored(ImVec4(1.0f, 0.35f, 0.3f, 1.0f), "Last restore failed (HTTP %u). See the session log.",
+                               s_RestoreHttpStatus.load());
+        if (s_RestoreLoadError.empty())
+        {
+            ImGui::SameLine();
+            if (ImGui::Button("Arm restore##restore"))
+            {
+                s_RestoreHttpStatus = 0;
+                s_RestoreRequest = nullptr;
+                s_RestoreSentAtMs = 0;  // the watchdog must never see an earlier attempt's time
+                s_RestoreState.store(k_RestoreArmed, std::memory_order_release);
+                Logger::Warn("[NoMoreAltF4] RESTORE ARMED: {}. Waiting for a campaign upload from the safehouse.",
+                             s_RestoreSummary);
+            }
+        }
+        break;
+    case k_RestoreArmed:
+        ImGui::TextColored(ImVec4(1.0f, 0.8f, 0.2f, 1.0f),
+            "Armed. In the safehouse, open the gear wall and switch to another page once.");
+        ImGui::SameLine();
+        if (ImGui::Button("Disarm##restore"))
+        {
+            int s_Expected = k_RestoreArmed;
+            if (s_RestoreState.compare_exchange_strong(s_Expected, k_RestoreIdle))
+                Logger::Info("[NoMoreAltF4] RESTORE disarmed.");
+        }
+        break;
+    case k_RestoreSent:
+        ImGui::TextColored(ImVec4(1.0f, 0.8f, 0.2f, 1.0f), "Sent. The game closes when the server answers (at most 10 s).");
+        ImGui::SameLine();
+        if (ImGui::Button("Close game now##restore"))
+        {
+            Logger::Warn("[NoMoreAltF4] RESTORE: game closed from the menu while waiting for the answer.");
+            KillProcess();
+        }
+        break;
+    case k_RestoreAccepted:
+        ImGui::TextColored(ImVec4(0.4f, 1.0f, 0.5f, 1.0f), "Sent and answered. The game is closing.");
+        break;
+    default:
+        break;
+    }
+}
+
+static bool RestoreAnswerOverdue()
+{
+    if (s_RestoreState.load() != k_RestoreSent)
+        return false;
+    const uint64_t s_SentAt = s_RestoreSentAtMs.load();
+    if (s_SentAt == 0 || GetTickCount64() - s_SentAt <= k_RestoreAnswerTimeoutMs)
+        return false;
+
+    int s_Sent = k_RestoreSent;
+    if (!s_RestoreState.compare_exchange_strong(s_Sent, k_RestoreFailed))
+        return false;  // the answer arrived meanwhile
+    Logger::Error("[NoMoreAltF4] RESTORE: no answer within {} s. The result is unknown; closing the game anyway.",
+                  k_RestoreAnswerTimeoutMs / 1000);
+    return true;
+}
+
+static void DrawRestoreNotice()
+{
+    const int s_State = s_RestoreState.load();
+    if (s_State != k_RestoreArmed && s_State != k_RestoreSent)
+        return;
+
+    const char* s_Text = (s_State == k_RestoreArmed)
+        ? ICON_MD_RESTORE " NoMoreAltF4: campaign restore armed. In the safehouse, open the gear wall and switch to another page once."
+        : ICON_MD_RESTORE " NoMoreAltF4: saved campaign sent. The game closes in a moment.";
+
+    const uint64_t s_SentAt = s_RestoreSentAtMs.load();
+    const bool s_Slow = (s_State == k_RestoreSent && s_SentAt != 0 && GetTickCount64() - s_SentAt > 3000);
+
+    ImGui::SetNextWindowPos(ImVec2(ImGui::GetIO().DisplaySize.x * 0.5f, 96.0f), ImGuiCond_Always, ImVec2(0.5f, 0.0f));
+    ImGui::SetNextWindowBgAlpha(0.8f);
+    const ImGuiWindowFlags s_Flags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize
+        | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav
+        | ImGuiWindowFlags_NoInputs;
+    if (ImGui::Begin("##NoMoreAltF4RestoreNotice", nullptr, s_Flags))
+    {
+        ImGui::TextColored(ImVec4(1.0f, 0.8f, 0.2f, 1.0f), "%s", s_Text);
+        if (s_Slow)
+            ImGui::TextUnformatted("Waiting for the server. Do not quit through the game's menu: the mod closes the game itself.");
+    }
