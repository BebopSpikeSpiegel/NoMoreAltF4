+bool FindCpdSetValue(const char* p_Data, size_t p_Len, const char* p_ContractId, size_t p_IdLen,
+                     size_t* p_Begin, size_t* p_End, uint32_t* p_Events, uint32_t* p_Matches)
+{
+    if (p_Matches)
+        *p_Matches = 0;
+    if (!p_Data || !p_ContractId || p_IdLen == 0 || !p_Begin || !p_End)
+        return false;
+
+    Ev s_Events[k_MaxEvents];
+    uint32_t s_Count = 0;
+    if (ScanBody(p_Data, p_Len, s_Events, s_Count) != Result::Clean)
+        return false;
+
+    if (p_Events)
+        *p_Events = s_Count;
+
+    bool s_Found = false;
+    uint32_t s_Matches = 0;
+    for (uint32_t i = 0; i < s_Count; ++i)
+    {
+        const Ev& s_Ev = s_Events[i];
+        if (!TokIs(p_Data, s_Ev.name, "\"CpdSet\""))
+            continue;
+        if (!s_Ev.cid.Has() || !IsStrTok(p_Data, s_Ev.cid) || s_Ev.cid.Len() - 2 != p_IdLen
+            || memcmp(p_Data + s_Ev.cid.b + 1, p_ContractId, p_IdLen) != 0)
+            continue;
+
+        ++s_Matches;
+        if (s_Found || !s_Ev.val.Has() || p_Data[s_Ev.val.b] != '{' || p_Data[s_Ev.val.e - 1] != '}')
+            continue;
+
+        *p_Begin = s_Ev.val.b;
+        *p_End = s_Ev.val.e;
+        s_Found = true;
+    }
+
+    if (p_Matches)
+        *p_Matches = s_Matches;
+    return s_Found;
+}
